{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DL Master",
  "version": "0.1.0",
  "identifier": "com.dlmaster.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DL Master",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "yt-dlp desktop download manager",
    "longDescription": "DL Master is a cross-platform desktop download manager powered by yt-dlp."
  }
}
